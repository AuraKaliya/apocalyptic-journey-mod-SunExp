<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>AuraToolsExp.Dll</RootNamespace>
    <AssemblyName>AuraToolsExp.Aura</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(MSBuildProjectDirectory)\..\Managed</ManagedPath>
    <DllPath>$(ManagedPath)</DllPath>
    <ModScriptsPath>..\AuraToolsExp\Scripts</ModScriptsPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuraSharedRuntime-Dev\Aura.Shared.csproj" Private="true" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="VisualAssets\UnityProject\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="netstandard">
      <HintPath>$(DllPath)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DllPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CsvHelper">
      <HintPath>$(DllPath)\CsvHelper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DllPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(DllPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(DllPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(DllPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(DllPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(DllPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(DllPath)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.VideoModule">
      <HintPath>$(DllPath)\UnityEngine.VideoModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(DllPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(DllPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(DllPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(DllPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(DllPath)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(DllPath)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(DllPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Witch">
      <HintPath>$(DllPath)\Witch.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Witch.Core">
      <HintPath>$(DllPath)\Witch.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins">
      <HintPath>$(DllPath)\Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(DllPath)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Transports">
      <HintPath>$(DllPath)\Mirror.Transports.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MemoryPack.Core">
      <HintPath>$(DllPath)\MemoryPack.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(DllPath)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target
      Name="GenerateAuraNativePrograms"
      BeforeTargets="BeforeCompile"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\tools\AuraNativeProgramCompiler\AuraNativeProgramCompiler.csproj&quot; -c Release -- --campaign &quot;$(MSBuildProjectDirectory)\..\AuraToolsExp\Config\combat-simulation\witch-world-simulation-v2.campaign.json&quot; --ruleset &quot;$(MSBuildProjectDirectory)\..\AuraToolsExp\Config\combat-simulation\witch-base-evaluation-v2.ruleset.json&quot; --subjects &quot;$(MSBuildProjectDirectory)\..\AuraToolsExp\Config\combat-simulation\witch-game-subjects-v1.catalog.json&quot; --output &quot;$(MSBuildProjectDirectory)\Features\AutoBattle\Generated\AuraToolsNativePrograms.g.cs&quot; --manifest &quot;$(MSBuildProjectDirectory)\..\AuraToolsExp\Config\combat-programs.base-game.manifest.json&quot;" />
  </Target>

  <Target Name="PublishAuraFoundationTrainer"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BuildFoundationTrainer)' == 'true'">
    <PropertyGroup>
      <FoundationTrainerStopArgument
          Condition="'$(StopRunningFoundationTrainer)' == 'true'">-StopRunningTrainer</FoundationTrainerStopArgument>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Build-AuraFoundationTrainer.ps1&quot; -Configuration $(Configuration) $(FoundationTrainerStopArgument)" />
  </Target>

</Project>

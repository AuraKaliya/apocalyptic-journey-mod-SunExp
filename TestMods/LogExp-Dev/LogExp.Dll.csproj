<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>LogExp.Dll</RootNamespace>
    <AssemblyName>LogExp.Aura</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(MSBuildProjectDirectory)\..\..\Managed</ManagedPath>
    <DllPath>$(ManagedPath)</DllPath>
    <ModScriptsPath>..\LogExp\Scripts</ModScriptsPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DllPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Witch">
      <HintPath>$(DllPath)\Witch.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Witch.Core">
      <HintPath>$(DllPath)\Witch.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyEntryDllToMod" AfterTargets="Build">
    <MakeDir Directories="$(ModScriptsPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(ModScriptsPath)\Entry.dll" />
  </Target>

</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/aura-registration-v3.schema.json",
  "title": "AuraShared registration manifest v3",
  "type": "object",
  "required": ["schemaVersion", "ownerModId", "participantKind", "packageId", "packageVersion", "resources"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "ownerModId": { "type": "string", "minLength": 1 },
    "participantKind": { "enum": ["Content", "Tool", "Foundation"] },
    "packageId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduleId", "featureId", "scopeType", "scopeId", "resourceId", "kind", "source"],
        "properties": {
          "moduleId": { "type": "string", "minLength": 1 },
          "featureId": { "type": "string", "minLength": 1 },
          "scopeType": { "type": "string", "minLength": 1 },
          "scopeId": { "type": "string", "minLength": 1 },
          "resourceId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["File", "Directory"] },
          "source": { "type": "string", "minLength": 1 },
          "fileName": { "type": "string" },
          "legacyPaths": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "integer" },
          "effectMode": { "enum": ["Additive", "Replacement"] },
          "missingPolicy": { "enum": ["Skip", "NativeFallback"] }
        },
        "additionalProperties": true
      }
    },
    "defaults": { "type": "array" }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aurashared/schema/resource-package.schema.json",
  "title": "AuraShared resource package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "packageVersion", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "ownerModId": { "type": "string" },
    "packageKind": {
      "enum": ["Resource", "RolePack", "JourneyPack", "AudioPack", "CgPack", "SkinPack", "ToolingPack"]
    },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId"],
        "properties": {
          "packageId": { "type": "string", "minLength": 1 },
          "minVersion": { "type": "integer", "minimum": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "Audio",
          "CG",
          "Skin",
          "Journey",
          "RolePack",
          "Diagnostics",
          "MultiplayerAuthority"
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "resourceId", "kind", "source", "destination"],
        "properties": {
          "system": { "type": "string", "minLength": 1 },
          "resourceId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["File", "Directory"] },
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 },
          "targetRoleIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}

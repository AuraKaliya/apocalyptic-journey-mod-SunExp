{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aurashared/schema/resource-package.schema.json",
  "title": "AuraShared resource package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "packageVersion", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "resourceId", "kind", "source", "destination"],
        "properties": {
          "system": { "type": "string", "minLength": 1 },
          "resourceId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["File", "Directory"] },
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

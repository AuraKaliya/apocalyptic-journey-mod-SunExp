    <Compile Include="..\AuraSkinShared\Services\SkinSelectionStore.cs" Link="Shared\SkinSelectionStore.cs" />
    <Compile Include="..\AuraSkinShared\Services\SkinScopedSelectionStore.cs" Link="Shared\SkinScopedSelectionStore.cs" />
    <Compile Include="..\AuraSkinShared\Services\SkinPackageValidationPolicy.cs" Link="Shared\SkinPackageValidationPolicy.cs" />

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AuraDecisionShared\*.cs" Link="Shared\Decision\%(Filename)%(Extension)" />
    <Compile Include="..\..\AuraCombatSimulationShared\*.cs" Link="Shared\Simulation\%(Filename)%(Extension)" />
    <Compile Include="..\..\AuraCombatAiShared\*.cs" Link="Shared\Combat\%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>

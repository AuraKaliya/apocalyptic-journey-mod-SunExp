{
  "schemaVersion": 2,
  "ruleSets": {
    "shared": {
      "scanRules": [
        {
          "id": "shared-product-independence",
          "description": "Shared runtime source must not depend on product or prototype semantics.",
          "roots": [
            "AuraSharedCore",
            "AuraAudioShared",
            "AuraCgShared",
            "AuraCardUseFxShared",
            "AuraDecisionShared",
            "AuraCombatSimulationShared",
            "AuraCombatAiShared",
            "AuraDirectorShared",
            "AuraLogShared",
            "AuraJourneyShared",
            "AuraModeShared",
            "AuraSkinShared",
            "AuraOnlineShared",
            "AuraRoleShared",
            "AuraGameDataShared",
            "AuraToolingShared",
            "AudioArbiterShared",
            "BattleBgmArbiterShared",
            "StarterDeckArbiterShared",
            "AuraUiShared",
            "UiRaycastSafetyShared",
            "UiTransitionGuardShared"
          ],
          "filePattern": "*.cs",
          "deny": [
            "\\bTerrias\\b",
            "\\bAuraToolsExp\\b",
            "\\bSanGuoShaExp\\b",
            "\\bTestMods\\b"
          ]
        },
        {
          "id": "core-domain-direction",
          "description": "AuraSharedCore must not reference a shared domain namespace.",
          "roots": ["AuraSharedCore"],
          "filePattern": "*.cs",
          "deny": [
            "\\bAuraCg\\.Shared\\b",
            "\\bAuraSkin\\.Shared\\b",
            "\\bAudioArbiter\\.Shared\\b",
            "\\bBattleBgmArbiter\\.Shared\\b",
            "\\bStarterDeckArbiter\\.Shared\\b",
            "\\bAuraCombatAi\\.Shared\\b",
            "\\bAuraJourney\\.Shared\\b",
            "\\bAuraMode\\.Shared\\b",
            "\\bAuraOnline\\.Shared\\b",
            "\\bAuraRole\\.Shared\\b",
            "\\bAuraGameData\\.Shared\\b",
            "\\bAuraDecision\\.Shared\\b",
            "\\bAuraDirector\\.Shared\\b"
          ]
        },
        {
          "id": "shared-retired-combat-action-router",
          "description": "Shared consumers must use the authoritative card action transaction router.",
          "roots": [
            "AuraSharedCore",
            "AuraCardUseFxShared",
            "AudioArbiterShared",
            "AuraCgShared"
          ],
          "filePattern": "*.cs",
          "deny": ["\\bAuraCombatActionRouter\\b", "\\bAuraCombatActionContext\\b"]
        }
      ]
    },
    "shared-write": {
      "scanRules": [
        {
          "id": "shared-write-entrypoint",
          "description": "Shared and consumer runtime writes must stay behind an approved storage owner.",
          "roots": [
            "AuraAudioShared",
            "AuraCardUseFxShared",
            "AuraCgShared",
            "AuraDirectorShared",
            "AuraDirectorDetour-Dev",
            "AuraJourneyShared",
            "AuraLogShared",
            "AuraModeShared",
            "AuraSkinShared",
            "AuraToolsExp-Dev",
            "Terrias-Dev"
          ],
          "filePattern": "*.cs",
          "excludePathRegex": [
            "^AuraLogShared/AuraLogRuntime\\.cs$",
            "^AuraToolsExp-Dev/Features/Logging/AuraToolsLogFileWriter\\.cs$",
            "^Terrias-Dev/GameApi/FamiliarGrowthApi\\.cs$",
            "^Terrias-Dev/Mechanics/EndlessAbyssRunLedger\\.cs$",
            "^Terrias-Dev/Mechanics/EndlessAbyssShockService\\.cs$",
            "^Terrias-Dev/Mechanics/EndlessSeaFloorPlanStore\\.cs$"
          ],
          "deny": [
            "File\\s*\\.\\s*WriteAll(?:Text|Bytes)\\s*\\(",
            "File\\s*\\.\\s*(?:OpenWrite|Create|Move|Replace)\\s*\\(",
            "Directory\\s*\\.\\s*Move\\s*\\(",
            "(?s)new\\s+FileStream\\s*\\([^;]*?FileMode\\.(?:Create|CreateNew|OpenOrCreate|Append|Truncate)"
          ]
        }
      ]
    },
    "content-tool": {
      "scanRules": [
        {
          "id": "tool-content-independence",
          "description": "AuraToolsExp must not depend on Terrias implementation or content semantics.",
          "roots": ["AuraToolsExp-Dev"],
          "filePattern": "*.cs",
          "deny": [
            "Terrias-Dev",
            "Terrias\\.Dll",
            "using\\s+Terrias",
            "CS\\.Terrias",
            "\\bTerriasIds\\b",
            "\\bSolarMemory\\b"
          ]
        },
        {
          "id": "content-tool-independence",
          "description": "Terrias must not depend on AuraToolsExp implementation.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "deny": [
            "AuraToolsExp-Dev",
            "AuraToolsExp\\.Dll",
            "using\\s+AuraToolsExp",
            "CS\\.AuraToolsExp"
          ]
        },
        {
          "id": "tool-hook-entrypoint",
          "description": "AuraToolsExp feature hooks must use the owner-qualified routed registry and may not use attribute or direct shared hooks.",
          "roots": ["AuraToolsExp-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["/AuraToolsHookRegistry\\.cs$"],
          "deny": [
            "AuraSharedHooks\\.(?:RegisterBefore|RegisterAfter)",
            "\\[Hook(?:Before|After)\\b"
          ]
        },
        {
          "id": "toolbox-shell-module-boundary",
          "description": "The AuraTools toolbox shell may depend on module contracts but not concrete feature runtimes.",
          "roots": ["AuraToolsExp-Dev/Features/Settings"],
          "filePattern": "ToolboxSettingsShell.cs",
          "deny": [
            "using\\s+AuraToolsExp\\.Dll\\.Features\\.(?:Audio|AutoBattle|CardRefresh|DamageMeter|Diagnostics|Feast|Logging|MatchRecords|ModSync|PixelEmoji|SafeBox|SkillCg|Skin|StarterDeck)"
          ]
        },
        {
          "id": "shared-native-hook-owner",
          "description": "Only AuraSharedHooks may install native ModConfig method hooks; shared domains subscribe through routed hooks or typed routers.",
          "roots": [
            "AuraSharedCore",
            "AuraAudioShared",
            "AuraCgShared",
            "AuraCardUseFxShared",
            "AuraJourneyShared",
            "AuraOnlineShared",
            "AuraSkinShared",
            "AudioArbiterShared",
            "BattleBgmArbiterShared",
            "StarterDeckArbiterShared",
            "UiTransitionGuardShared"
          ],
          "filePattern": "*.cs",
          "excludePathRegex": ["^AuraSharedCore/AuraSharedHooks\\.cs$"],
          "deny": [
            "AddMethodHook(?:Before|After)\\s*\\(",
            "\\[Hook(?:Before|After)\\b"
          ]
        },
        {
          "id": "product-native-hook-owner",
          "description": "Product mods must subscribe through their routed registry or a typed shared router rather than installing native hooks directly.",
          "roots": [
            "AuraToolsExp-Dev",
            "Terrias-Dev"
          ],
          "filePattern": "*.cs",
          "deny": [
            "AddMethodHook(?:Before|After)\\s*\\(",
            "\\[Hook(?:Before|After)\\b"
          ]
        },
        {
          "id": "tool-entry-module-host-boundary",
          "description": "AuraTools Entry must compose feature behavior through AuraToolModuleHost.",
          "roots": ["AuraToolsExp-Dev"],
          "filePattern": "Entry.cs",
          "deny": [
            "using\\s+AuraToolsExp\\.Dll\\.Features\\.(?:Audio|AutoBattle|CardRefresh|DamageMeter|Diagnostics|Feast|Logging|MatchRecords|ModSync|PixelEmoji|SafeBox|SkillCg|Skin|StarterDeck)",
            "AuraTools(?:Audio|AutoBattle|CardRefresh|DamageMeter|CardUiBenchmark|Feast|FileLog|MatchRecords|ModSync|PixelEmoji|SafeBox|SkillCg|Skin|StarterDeck)Runtime\\.Initialize"
          ]
        },
        {
          "id": "tool-settings-runtime-injection-only",
          "description": "AuraToolsSettingsRuntime owns native SettingUI injection only; modules own concrete settings pages.",
          "roots": ["AuraToolsExp-Dev/Features/Settings"],
          "filePattern": "AuraToolsSettingsRuntime.cs",
          "deny": [
            "using\\s+AuraToolsExp\\.Dll\\.Features\\.(?:Audio|AutoBattle|CardRefresh|DamageMeter|Diagnostics|Feast|Logging|MatchRecords|ModSync|PixelEmoji|SafeBox|SkillCg|Skin|StarterDeck)",
            "AuraToolsConfigService",
            "Show(?:Audio|StarterDeck|Replay|AutoBattle|Logging)Settings",
            "AutoInstallBundledSkins\\s*=\\s*true",
            "PreferRoleModProfile\\s*=\\s*true",
            "feast\\.PlayCg\\s*=\\s*true"
          ]
        },
        {
          "id": "tool-module-settings-page-ownership",
          "description": "Built-in modules must route settings directly to feature-owned pages, not back through the settings injector.",
          "roots": ["AuraToolsExp-Dev/Modules"],
          "filePattern": "AuraToolsBuiltInModules.cs",
          "deny": [
            "AuraToolsSettingsRuntime",
            "Features\\.Settings"
          ]
        },
        {
          "id": "tool-module-config-isolation",
          "description": "AuraTools features use module-scoped saves and subscriptions instead of aggregate config broadcasts or hidden root gates.",
          "roots": ["AuraToolsExp-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": [
            "^AuraToolsExp-Dev/Config/"
          ],
          "deny": [
            "AuraToolsConfigService\\.(?:Changed|AudioChanged|MatchExperienceChanged|LoggingChanged)\\s*\\+=",
            "AuraToolsConfigService\\.(?:SaveAudio|SaveMatchExperience)\\s*\\(",
            "AuraToolsConfigService\\.Root\\.(?:Audio|MatchExperience|PixelEmoji|SkillCg|Skin|Logging)\\.Enabled"
          ]
        },
        {
          "id": "tool-shared-extension-adapter-boundary",
          "description": "Shared tool extension adapters may depend on the public Tooling protocol and internal module contracts, not concrete AuraTools features.",
          "roots": ["AuraToolsExp-Dev/Modules"],
          "filePattern": "AuraToolSharedExtensionAdapter.cs",
          "deny": [
            "using\\s+AuraToolsExp\\.Dll\\.Features\\.(?:Audio|AutoBattle|CardRefresh|DamageMeter|Diagnostics|Feast|Logging|MatchRecords|ModSync|PixelEmoji|SafeBox|SkillCg|Skin|StarterDeck)"
          ]
        },
        {
          "id": "content-hook-entrypoint",
          "description": "Terrias feature hooks must route through TerriasHookRegistry.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["/TerriasHookRegistry\\.cs$"],
          "deny": ["AuraSharedHooks\\.(?:RegisterBefore|RegisterAfter)"]
        },
        {
          "id": "replay-v11-core-purity",
          "description": "Replay v11 models, canonical hashing, validation, and projection must remain pure .NET.",
          "roots": ["AuraToolsExp-Dev/Features/MatchRecords/Replay/Core"],
          "filePattern": "*.cs",
          "deny": [
            "using\\s+UnityEngine",
            "using\\s+Witch",
            "using\\s+Mirror",
            "using\\s+System\\.IO",
            "using\\s+System\\.Diagnostics"
          ]
        },
        {
          "id": "replay-v11-native-view-containment",
          "description": "Native replay may build presentation-only FightUI objects but must not execute gameplay, RPC, AI, or network-host lifecycles.",
          "roots": ["AuraToolsExp-Dev/Features/MatchRecords"],
          "filePattern": "*.cs",
          "deny": [
            "StartLocalHost",
            "RpcLoadRoles",
            "new\\s+FightInit\\s*\\(",
            "\\.RunScript\\s*\\(",
            "\\.ActionExecute\\s*\\(",
            "NetworkServer\\.(?:Listen|Shutdown)",
            "NetworkClient\\.(?:Connect|Shutdown)",
            "\\.(?:Cmd|Rpc)[A-Z][A-Za-z0-9_]*\\s*\\("
          ]
        },
        {
          "id": "replay-v11-retired-paths",
          "description": "The v11 native replay product must not restore the synthetic scene, screen capture, listener recording, AVI fallback, or PATH encoder discovery.",
          "roots": ["AuraToolsExp-Dev/Features/MatchRecords"],
          "filePattern": "*.cs",
          "deny": [
            "ScreenCapture\\.CaptureScreenshotAsTexture",
            "FindAnyObjectByType<AudioListener>",
            "\\bMjpegAviWriter\\b",
            "\\bReplayFrameSpool\\b",
            "\\bReplaySceneRuntime\\b",
            "\\bReplayTimelineController\\b",
            "aura-replay-2d",
            "native-or-silence",
            "Environment\\.GetEnvironmentVariable\\(\\\"PATH\\\"\\)",
            "falling back to built-in AVI"
          ]
        }
      ]
    },
    "terrias": {
      "semanticLayers": {
        "projectRoot": "Terrias-Dev",
        "maxExceptions": 64,
        "layers": [
          {
            "id": "Infrastructure",
            "roots": ["Terrias-Dev/Infrastructure"],
            "namespacePrefix": "Terrias.Dll.Infrastructure",
            "allowedDependencies": []
          },
          {
            "id": "GameApi",
            "roots": ["Terrias-Dev/GameApi"],
            "namespacePrefix": "Terrias.Dll.GameApi",
            "allowedDependencies": ["Infrastructure"]
          },
          {
            "id": "Mechanics",
            "roots": ["Terrias-Dev/Mechanics"],
            "namespacePrefix": "Terrias.Dll.Mechanics",
            "allowedDependencies": ["GameApi", "Infrastructure"]
          },
          {
            "id": "Application",
            "roots": ["Terrias-Dev/Application"],
            "namespacePrefix": "Terrias.Dll.Application",
            "allowedDependencies": ["Mechanics", "GameApi", "Infrastructure"]
          },
          {
            "id": "Scripting",
            "roots": ["Terrias-Dev/Scripting"],
            "namespacePrefix": "Terrias.Dll.Scripting",
            "allowedDependencies": ["Application", "Mechanics", "GameApi", "Infrastructure"]
          },
          {
            "id": "Network",
            "roots": ["Terrias-Dev/Network"],
            "namespacePrefix": "Terrias.Dll.Network",
            "allowedDependencies": ["Application", "Infrastructure"]
          },
          {
            "id": "Hooks",
            "roots": ["Terrias-Dev/Hooks"],
            "namespacePrefix": "Terrias.Dll.Hooks",
            "allowedDependencies": ["Application", "Mechanics", "GameApi", "Infrastructure"]
          },
          {
            "id": "Features",
            "roots": ["Terrias-Dev/Features"],
            "namespacePrefix": "Terrias.Dll.Features",
            "allowedDependencies": ["Application", "Mechanics", "GameApi", "Infrastructure"]
          },
          {
            "id": "Entry",
            "files": ["Terrias-Dev/Entry.cs"],
            "namespacePrefix": "Terrias.Dll",
            "allowedDependencies": ["Application", "Features", "Hooks", "Network", "Scripting", "Mechanics", "GameApi", "Infrastructure"]
          }
        ]
      },
      "namespaceRules": [
        { "root": "Terrias-Dev/Infrastructure", "prefix": "Terrias.Dll.Infrastructure" },
        { "root": "Terrias-Dev/GameApi", "prefix": "Terrias.Dll.GameApi" },
        { "root": "Terrias-Dev/Mechanics", "prefix": "Terrias.Dll.Mechanics" },
        { "root": "Terrias-Dev/Application", "prefix": "Terrias.Dll.Application" },
        { "root": "Terrias-Dev/Network", "prefix": "Terrias.Dll.Network" },
        { "root": "Terrias-Dev/Hooks", "prefix": "Terrias.Dll.Hooks" },
        { "root": "Terrias-Dev/Features", "prefix": "Terrias.Dll.Features" },
        { "root": "Terrias-Dev/Scripting", "prefix": "Terrias.Dll.Scripting" }
      ],
      "scanRules": [
        {
          "id": "terrias-sibling-independence",
          "description": "Terrias must remain independent from sibling product and prototype implementations.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "deny": ["\\bAuraToolsExp\\b", "\\bSanGuoShaExp\\b", "\\bTestMods\\b"]
        },
        {
          "id": "scripting-entry-boundary",
          "description": "CSV-callable scripting code must not own hooks, schedulers, or raw event registration.",
          "roots": ["Terrias-Dev/Scripting"],
          "filePattern": "*.cs",
          "deny": [
            "using\\s+Terrias\\.Dll\\.Hooks",
            "\\bTerriasFrameScheduler\\b",
            "\\.\\s*Add(?:Temp)?Event\\s*\\("
          ]
        },
        {
          "id": "hook-registration-isolation",
          "description": "Raw Terrias hook registration must stay under Hooks or the composition entry point.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["^Terrias-Dev/Hooks/", "^Terrias-Dev/Entry\\.cs$"],
          "deny": [
            "TerriasHookRegistry\\.(?:Before|After|Register)",
            "\\bModHook\\.Add",
            "\\bAddMethodHook(?:Before|After)\\b"
          ]
        },
        {
          "id": "resource-loader-boundary",
          "description": "Terrias resource loads must be centralized in TerriasResourceCache.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["/TerriasResourceCache\\.cs$"],
          "deny": ["ResourceLoader\\.Load(?:All)?(?:<|\\s*\\()"]
        },
        {
          "id": "config-index-boundary",
          "description": "Table scans outside GameApi must be centralized in TerriasConfigIndex.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["^Terrias-Dev/GameApi/", "/TerriasConfigIndex\\.cs$"],
          "deny": ["\\bGetTable\\s*\\("]
        },
        {
          "id": "combat-card-draw-entrypoint",
          "description": "Terrias combat draws must pass through the terminal-aware CombatCardApi.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["^Terrias-Dev/GameApi/CombatCardApi\\.cs$"],
          "deny": ["\\.\\s*DrawCount\\s*\\("]
        },
        {
          "id": "terrias-retired-battle-runtime-paths",
          "description": "Terrias must not restore persistent Vars hook tokens, the old action router, or the permanent Projection poller.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "deny": [
            "\\bTerriasActionEventRouter\\b",
            "\\bTerriasActionEventContext\\b",
            "\\bRegisterHook\\s*\\(",
            "\\bClearHook\\s*\\(",
            "\\bTryAddTokenedEvent",
            "(?:TryAddEvent|AddRequired)(?:<[^>]+>)?\\s*\\(\\s*(?:self\\s*,\\s*)?\"Action(?:After)?\"",
            "\\bProjectionNetworkRunner\\b",
            "\\bTickNetworkSynchronization\\b",
            "\\bTerriasCardRefreshQueue\\b",
            "\\bCardGrantPostCommitQueue\\b",
            "\\bcard\\.RefreshTag\\s*\\(",
            "\\bTerriasHookTargets\\.(?:FightStartInit|FightInitInit|FightWinInit|FightWinResetStates|FightEscapeInit|FightEscapeResetStates|FightLossInit|FightPlayerTurnInit|SkillItemTrueUse)\\b",
            "\\b(?:FightInitializing|FightStarting|FightInitialized|FightStarted|PlayerRoundStarted|FightRestarting|FightRestarted|FightEnding|FightEnded)\\s*="
          ]
        },
        {
          "id": "terrias-event-listener-entrypoint",
          "description": "Terrias EventCenter listener ownership must route through ScriptEventApi and battle leases.",
          "roots": ["Terrias-Dev"],
          "filePattern": "*.cs",
          "excludePathRegex": ["^Terrias-Dev/GameApi/ScriptEventApi\\.cs$"],
          "deny": ["EventCenter\\.Instance\\.AddEventListener"]
        }
      ]
    }
  }
}

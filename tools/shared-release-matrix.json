{
  "schemaVersion": 1,
  "name": "AuraShared release gate",
  "steps": [
    {
      "id": "core-contract",
      "kind": "script",
      "path": "tools/Test-AuraSharedCore.ps1",
      "enabled": true
    },
    {
      "id": "write-entrypoint-scan",
      "kind": "script",
      "path": "tools/Test-SharedWriteEntrypoints.ps1",
      "enabled": true
    },
    {
      "id": "architecture-guideline-scan",
      "kind": "script",
      "path": "tools/Test-SharedArchitectureGuidelines.ps1",
      "enabled": true
    },
    {
      "id": "content-tool-shared-boundary",
      "kind": "script",
      "path": "tools/Test-ContentToolSharedBoundary.ps1",
      "enabled": true
    },
    {
      "id": "network-rpc-authority",
      "kind": "script",
      "path": "tools/Test-NetworkRpcAuthority.ps1",
      "enabled": true
    },
    {
      "id": "director-detour-technical-probe",
      "kind": "script",
      "path": "tools/Test-AuraDirectorDetour.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "auratools-feature-tests",
      "kind": "script",
      "path": "tools/Test-AuraToolsExp.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "main-consumers",
      "kind": "script",
      "path": "tools/Test-MainSharedFramework.ps1",
      "enabled": true
    },
    {
      "id": "shared-dll-packaging",
      "kind": "script",
      "path": "tools/Test-SharedDllPackaging.ps1",
      "enabled": true,
      "passConfiguration": true
    }
  ],
  "requiredContracts": {
    "protocolVersion": 2,
    "buildId": "aura-shared-core-2026-06-22-v2",
    "operationLog": "Logs/Operations/yyyyMMdd.jsonl",
    "lockOrder": ["Resource", "Registry", "WriteMutex"]
  },
  "adapterSurfaces": ["Skin", "Audio", "CG", "Log", "Journey"],
  "releaseScenarios": [
    "SunExp only",
    "SunExp + AuraToolsExp",
    "AuraToolsExp skin + SunExp",
    "SkinExp legacy prototype + SunExp",
    "SanGuoShaExp + SunExp",
    "SunExp + SanGuoShaExp + AuraToolsExp"
  ]
}

  "adapterSurfaces": ["Skin", "Audio", "CG", "CardUseFx", "Decision", "CombatAI", "Director", "GameData", "Log", "Journey", "Mode"],
  "releaseScenarios": [
    "Terrias only",
    "Terrias + AuraToolsExp",

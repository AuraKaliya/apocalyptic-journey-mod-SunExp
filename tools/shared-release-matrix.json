{
  "schemaVersion": 1,
  "name": "AuraShared release gate",
  "steps": [
    {
      "id": "core-contract",
      "kind": "script",
      "path": "tools/Test-AuraSharedCore.ps1",
      "enabled": true
    },
    {
      "id": "shared-runtime-compatibility",
      "kind": "script",
      "path": "tools/Test-SharedRuntimeCompatibility.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "auracg-behavior",
      "kind": "script",
      "path": "tools/Test-AuraCgShared.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "audioarbiter-behavior",
      "kind": "script",
      "path": "tools/Test-AudioArbiterShared.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "write-entrypoint-scan",
      "kind": "script",
      "path": "tools/Test-SharedWriteEntrypoints.ps1",
      "enabled": true
    },
    {
      "id": "architecture-guideline-scan",
      "kind": "script",
      "path": "tools/Test-SharedArchitectureGuidelines.ps1",
      "enabled": true
    },
    {
      "id": "content-tool-shared-boundary",
      "kind": "script",
      "path": "tools/Test-ContentToolSharedBoundary.ps1",
      "enabled": true
    },
    {
      "id": "network-rpc-authority",
      "kind": "script",
      "path": "tools/Test-NetworkRpcAuthority.ps1",
      "enabled": true
    },
    {
      "id": "director-local-runtime",
      "kind": "script",
      "path": "tools/Test-AuraDirectorDetour.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "auratools-feature-tests",
      "kind": "script",
      "path": "tools/Test-AuraToolsExp.ps1",
      "enabled": true,
      "passConfiguration": true
    },
    {
      "id": "main-consumers",
      "kind": "script",
      "path": "tools/Test-MainSharedFramework.ps1",
      "enabled": true
    },
    {
      "id": "shared-dll-packaging",
      "kind": "script",
      "path": "tools/Test-SharedDllPackaging.ps1",
      "enabled": true,
      "passConfiguration": true
    }
  ],
  "requiredContracts": {
    "protocolVersion": 4,
    "buildIdPrefix": "aura-shared-core-v4-",
    "buildIdSource": "assembly-mvid",
    "operationLog": "Logs/Operations/yyyyMMdd.jsonl",
    "lockOrder": ["Resource", "Registry", "WriteMutex"]
  },
  "adapterSurfaces": ["Skin", "Audio", "CG", "CardUseFx", "Director", "GameData", "Log", "Journey", "Mode"],
  "releaseScenarios": [
    "Terrias only",
    "Terrias + AuraToolsExp",
    "AuraToolsExp skin + Terrias",
    "SanGuoShaExp + Terrias",
    "Terrias + SanGuoShaExp + AuraToolsExp"
  ]
}

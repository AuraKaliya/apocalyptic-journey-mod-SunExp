/Terrias-Dev/VisualAssets/UnityProject/

# Rebuildable shipped binary destinations. Existing tracked release binaries
# remain tracked; these rules prevent accidental addition of new binaries.
/Terrias/Scripts/
/AuraToolsExp/Scripts/
/SanGuoShaExp/Scripts/
/TestMods/*.dll

# Trainer executables are normally rebuilt. The Simulation Viewer is an
# intentional shipped surface and remains addable.
/AuraToolsExp/TrainingWorker/*.exe
!/AuraToolsExp/TrainingWorker/AuraFoundationTrainer.SimulationViewer.exe

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aurashared/schema/skin-package.schema.json",
  "title": "AuraSkinShared installable skin package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "packageVersion", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "minLength": 1 },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "participantKind": { "enum": ["Content", "Tool"] },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "schemaVersion": 1,
  "releaseBaseline": "0.11.0",
  "globalExactModVersionRequired": false,
  "features": [
    {
      "id": "multiplayer.mod-sync",
      "currentVersion": 2,
      "minimumSupportedVersion": 1,
      "requiredCapabilities": [
        "host-manifest.v1"
      ],
      "fallback": "targeted-v2 -> broadcast-v2 -> broadcast-v1 -> lobby-summary"
    },
    {
      "id": "presentation.pixel-emoji",
      "currentVersion": 2,
      "minimumSupportedVersion": 2,
      "requiredCapabilities": [
        "indexed-frames.v1",
        "palette-indices.v1",
        "content-sha256.v1"
      ],
      "fallback": "reject-presentation-only"
    },
    {
      "id": "records.damage-meter",
      "currentVersion": 4,
      "minimumSupportedVersion": 4,
      "minimumReadableVersion": 3,
      "requiredCapabilities": [
        "sequenced-events.v1",
        "hp-shield-damage.v1",
        "snapshot-state.v1"
      ],
      "fallback": "request-compatible-snapshot-or-disable-damage-meter-only"
    },
    {
      "id": "presentation.event-cg",
      "currentVersion": 1,
      "minimumSupportedVersion": 1,
      "requiredCapabilities": [
        "signal-registry.v4",
        "processed-team-scene.v1",
        "owner-qualified-assets.v1"
      ],
      "fallback": "disable-remote-event-cg-and-keep-local-registered-cg"
    },
    {
      "id": "records.match-replay",
      "currentVersion": 17,
      "minimumSupportedVersion": 17,
      "requiredCapabilities": [
        "causal-transactions.v2",
        "perspective-visible-state.v1",
        "resolved-instruction-stream.v1",
        "unified-transaction-order.v1",
        "deterministic-visible-reducer.v1",
        "visible-state-checkpoints.v1",
        "native-resource-projection.v3",
        "measured-native-layout.v1",
        "native-prefab-presentation.v1",
        "shared-mod-presentation.v1",
        "observed-overlap-tracks.v1",
        "visual-state-commit.v1",
        "native-card-view.v1",
        "observed-presentation-timeline.v3",
        "native-fight-ui.v1",
        "native-renderer-profile.v1",
        "pixel-readback-preflight.v1",
        "shared-presentation-modules.v1",
        "incremental-persistence.v1",
        "crash-resumable-finalization.v1",
        "owner-qualified-replay-extensions.v1"
      ],
      "fallback": "reject-structured-replay-and-retain-summary-analysis-verified-mp4"
    }
  ]
}

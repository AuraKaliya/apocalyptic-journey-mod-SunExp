{
  "schemaVersion": 3,
  "enabled": true,
  "fileNamePattern": "AuraTools-{date}.log",
  "minimumLevel": "Info",
  "mirrorUnityLog": false,
  "mirrorCommandsLog": false,
  "enabledSources": [
    "AuraTools"
  ],
  "unityLogTypes": [
    "Warning",
    "Error",
    "Exception",
    "Assert"
  ],
  "stackTraceMode": "ErrorsOnly",
  "maxQueueLength": 1024,
  "flushIntervalMs": 1000,
  "maxRetainedLogFiles": 10
}

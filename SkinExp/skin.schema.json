{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skinexp/schema/skin.schema.json",
  "title": "SkinExp skin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skinId", "name", "assets"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "enabled": { "type": "boolean", "default": true },
    "skinId": { "type": "string", "minLength": 1 },
    "targetCareerId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "preview": { "type": "string" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CareerImage": { "type": "string" },
        "Avatar": { "type": "string" },
        "Character": { "type": "string" },
        "DollIcon": { "type": "string" },
        "ChoiceIcon": { "type": "string" },
        "Animation": { "type": "string" }
      },
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 1 } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["targetCareerId"] }
    }
  ]
}

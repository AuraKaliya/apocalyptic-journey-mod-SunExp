<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Aura.Shared</RootNamespace>
    <AssemblyName>Aura.Shared</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(MSBuildProjectDirectory)\..\Managed</ManagedPath>
    <DllPath>$(ManagedPath)</DllPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AuraSharedCore\*.cs" Link="AuraSharedCore\%(Filename)%(Extension)" />
    <Compile Include="..\AuraAudioShared\*.cs" Link="AuraAudioShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraCgShared\*.cs" Link="AuraCgShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraCardUseFxShared\*.cs" Link="AuraCardUseFxShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraDecisionShared\**\*.cs" Link="AuraDecisionShared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuraCombatSimulationShared\**\*.cs" Link="AuraCombatSimulationShared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuraCombatAiShared\**\*.cs" Link="AuraCombatAiShared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuraDirectorShared\*.cs" Link="AuraDirectorShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraLogShared\*.cs" Link="AuraLogShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraJourneyShared\*.cs" Link="AuraJourneyShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraModeShared\*.cs" Link="AuraModeShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraSkinShared\**\*.cs" Link="AuraSkinShared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AuraOnlineShared\*.cs" Link="AuraOnlineShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraRoleShared\*.cs" Link="AuraRoleShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraReplayVisibleStateShared\*.cs" Link="AuraReplayVisibleStateShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraReplayPresentationShared\*.cs" Link="AuraReplayPresentationShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraGameDataShared\**\*.cs" Link="AuraGameDataShared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\AudioArbiterShared\*.cs" Link="AudioArbiterShared\%(Filename)%(Extension)" />
    <Compile Include="..\BattleBgmArbiterShared\*.cs" Link="BattleBgmArbiterShared\%(Filename)%(Extension)" />
    <Compile Include="..\StarterDeckArbiterShared\*.cs" Link="StarterDeckArbiterShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraUiShared\*.cs" Link="AuraUiShared\%(Filename)%(Extension)" />
    <Compile Include="..\AuraToolingShared\*.cs" Link="AuraToolingShared\%(Filename)%(Extension)" />
    <Compile Include="..\UiRaycastSafetyShared\UiRaycastSafeDestroyRuntime.cs" Link="UiRaycastSafetyShared\UiRaycastSafeDestroyRuntime.cs" />
    <Compile Include="..\UiTransitionGuardShared\UiTransitionGuardRuntime.cs" Link="UiTransitionGuardShared\UiTransitionGuardRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
